+
+void sm4_ctr_encrypt_do(
+    at::Tensor &key_stream,
+    at::Tensor &input,
+    at::Tensor &output,
+    int64_t element_count,
+    bool is_enc,
+    int64_t tp_size = 1
+){
+    if (sm4_current_pos == -1) {
+        sm4_current_pos = element_count;
+    }
+
+    char* input_ptr = reinterpret_cast<char*>(input.data_ptr());
+    char* output_ptr = reinterpret_cast<char*>(output.data_ptr());
+    uint8_t* base_ptr = reinterpret_cast<uint8_t*>(key_stream.data_ptr());
+    int64_t data_size = input.nbytes();
+
+    uint32_t maxValue = 4096;
+
+    const aclrtStream stream = getEncryptionStream();
+
+    if (sm4_current_pos + data_size / tp_size > element_count) {
+        const uint32_t threadnum = SM4_THREAD_NUM;
+
+        uint8_t rk128[SM4_RK_BYTES];
+        expandKeySM4(key, rk128);
+
+        void* deviceRoundKeys = nullptr;
+        aclrtMalloc(&deviceRoundKeys, SM4_RK_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
+        aclrtMemcpy(deviceRoundKeys, SM4_RK_BYTES, rk128, SM4_RK_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
+
+        at_npu::native::OpCommand cmd;
+        cmd.Name("sm4_generate_mask");
+        cmd.SetCustomHandler([stream, threadnum, deviceRoundKeys, base_ptr, element_count]() -> int {
+            sm4_ctr_encrypt_do_impl(threadnum, stream, deviceRoundKeys, base_ptr, base_ptr, static_cast<uint32_t>(element_count));
+            return 0;
+        });
+        cmd.Run();
+
+        sm4_current_pos = 0;
+    }
+
+    void* key_stream_ptr = base_ptr + sm4_current_pos;
+
+    for (int i = 0; i < tp_size; i++) {
+        at_npu::native::OpCommand cmd;
+        cmd.Name("xor_do");
+        void* input_ptr_ = reinterpret_cast<void*>(input_ptr + i * (data_size / tp_size));
+        void* output_ptr_ = reinterpret_cast<void*>(output_ptr + i * (data_size / tp_size));
+        cmd.SetCustomHandler([stream, key_stream_ptr, input_ptr_, output_ptr_, data_size, tp_size, maxValue]() -> int {
+            xor_do_impl(stream, key_stream_ptr, input_ptr_, output_ptr_, data_size / tp_size, maxValue);
+            return 0;
+        });
+        cmd.Run();
+    }
+
+    if (!is_enc) {
+        sm4_current_pos += data_size / tp_size;
+    }
+
+    return;
+}
